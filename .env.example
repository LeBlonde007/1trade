# 1Trade — root env example (services read only env vars; see docs/plans/LOCAL_DEV.md §4).
# Copy to .env for local dev. NEVER commit a real .env (it is gitignored). Real-env secrets come
# from SOPS-sealed manifests (M1) / Vault (M4) — see DECISIONS.md ADR-0001.

TRADE1_ENV=dev               # dev | staging | prod
TRADE1_PAPER=true            # is_paper at the runtime level; dev defaults to true

# data plane (k3d in-cluster services; ports forwarded per deploy/k8s/local)
DATABASE_URL=postgres://1trade:1trade@localhost:5432/1trade
TIMESCALE_URL=postgres://1trade:1trade@localhost:5433/1trade_ts
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

LOG_LEVEL=debug                # debug | info | warn | error
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

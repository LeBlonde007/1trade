# Exascale sandbox deploy settings — copy this to `sandbox.env`, fill the THREE secrets, then:
#
#   cp sandbox.env.example sandbox.env      # `sandbox.env` is gitignored — never commit real secrets
#   # edit sandbox.env: paste the rotated REGISTRY_TOKEN, INFERENCE_API_KEY, SMTP_PASS
#   source sandbox.env && bash scripts/deploy-sandbox.sh
#
# Single-quote any secret that contains shell-special chars (e.g. `!`) so the shell takes it literally.

# ── Registry: pull prebuilt images from GHCR (no source on the box) ──────────────────────────────
export IMAGE_REGISTRY=ghcr.io/saadallahdev
export REGISTRY_USER=saadallahdev
export REGISTRY_TOKEN='PASTE_ROTATED_READ_PACKAGES_PAT'   # ghp_… (GitHub → Settings → Tokens classic, read:packages)

# ── Cluster + HTTPS ──────────────────────────────────────────────────────────────────────────────
export INSTALL_K3S=1                                      # install k3s if absent (no-op if already there)
export TLS=1                                              # Let's Encrypt cert (both hosts must resolve first)
export ACME_EMAIL='you@example.com'                       # ← your REAL email (cert expiry notices)

# ── Public hosts (point BOTH A records at the VPS IP) ────────────────────────────────────────────
export SANDBOX_HOST=sandbox.exascale.ai                   # web app (browser)
export SANDBOX_API_HOST=sandboxapi.exascale.ai            # JSON API (exascale CLI / clients)

# ── Real inference via OpenRouter (free models → works on a $0 key) ──────────────────────────────
export INFERENCE_API_KEY='PASTE_ROTATED_OPENROUTER_KEY'   # sk-or-…  (omit this line to use the echo CPU stub)

# ── Real verification email + verify-before-login (PrivateEmail by default) ──────────────────────
export SMTP_PASS='PASTE_ROTATED_MAILBOX_PASSWORD'         # omit this line to keep Mailpit + no login gate
# Optional overrides (defaults shown — uncomment to change):
# export SMTP_ADDR=mail.privateemail.com:465
# export SMTP_TLS=implicit                                # implicit (465) | starttls (587)
# export EMAIL_FROM=hello@exascale.ai
# export SMTP_USER=hello@exascale.ai

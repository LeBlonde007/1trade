{
  "title": "1Trade \u2014 platform overview",
  "uid": "1trade-overview",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "1trade"
  ],
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Services \u2014 RED",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_requests_total[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx error ratio",
      "description": "Pages above 5% with real traffic (OneTradeHighErrorRate).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_requests_total{code=~\"5..\"}[5m])) / sum by (job) (rate(http_requests_total[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p99 latency",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (job, le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "In-flight requests",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (http_requests_in_flight)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Billing \u2014 usage vs. debits",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Inference requests vs. inference debits",
      "description": "The two lines should move together. Requests without debits = unbilled usage (OneTradeInferenceBillingStalled).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(inference_requests_total[5m]))",
          "legendFormat": "inference requests/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ledger_transactions_total{operation=\"consumption\", credit_type!~\"gpu_.*\"}[5m]))",
          "legendFormat": "ledger inference debits/s"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "GPU usage events vs. GPU debits",
      "description": "Should move together (OneTradeComputeBillingStalled).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(compute_usage_events_total[5m]))",
          "legendFormat": "usage events/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ledger_transactions_total{operation=\"consumption\", credit_type=~\"gpu_.*\"}[5m]))",
          "legendFormat": "ledger GPU debits/s"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Ledger transactions by operation",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(ledger_transactions_total[5m]))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Inference tokens",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (rate(inference_tokens_total[5m]))",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "GPU-seconds metered",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (credit_type) (rate(compute_gpu_seconds_total[5m]))",
          "legendFormat": "{{credit_type}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Exchange & market integrity",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Surveillance alerts raised",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rule, severity) (increase(surveillance_alerts_total[1h]))",
          "legendFormat": "{{rule}} \u00b7 {{severity}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Surveillance events processed",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (subject, outcome) (rate(surveillance_events_total[5m]))",
          "legendFormat": "{{subject}} \u00b7 {{outcome}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Blocked order / cancel attempts (venue paused)",
      "description": "Order entry is closed pending licensing (F22); this shows demand hitting the gate.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(trading_order_attempts_blocked_total[5m]))",
          "legendFormat": "orders"
        },
        {
          "refId": "B",
          "expr": "sum(rate(trading_cancel_attempts_blocked_total[5m]))",
          "legendFormat": "cancels"
        }
      ]
    }
  ]
}